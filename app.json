{
  "expo": {
    "name": "ReturnX - Nivesh Calculator",
    "slug": "returnx-nivesh-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "returnx",
    "description": "Smart Return Calculator for Every Investment. Calculate SIP, EMI, Compound Interest, and compare Loan vs Investment returns.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.returnx.nivesh"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "package": "com.returnx.nivesh",
      "permissions": [],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "admob": {
        "androidAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
        "iosAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
        "enabled": false
      },
      "eas": {
        "projectId": "a017679b-7999-475e-950a-764f6cb0f1ad"
      }
    },
    "owner": "tarunmankar04"
  }
}
